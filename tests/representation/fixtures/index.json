    },
    {
      "file": "negative/promotion-gate-draft-declared-ready.json",
      "expect": "invalid",
      "intended_error_code": "SCHEMA_ENUM_MISMATCH",
      "expected_schema_path_contains": [
        "allOf",
        "4",
        "then",
        "properties",
        "readinessStatus",
        "enum"
      ],
      "expected_instance_path_contains": [],
